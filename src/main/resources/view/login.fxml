<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.LoginController"
            prefHeight="400.0" prefWidth="600.0">

    <children>
        <VBox alignment="CENTER" spacing="12.0" AnchorPane.topAnchor="40.0" AnchorPane.leftAnchor="80.0" AnchorPane.rightAnchor="80.0">
            <Label text="Iniciar sesión" style="-fx-font-size:18px; -fx-font-weight:bold;"/>
            <TextField fx:id="usernameField" promptText="Usuario" />
            <PasswordField fx:id="passwordField" promptText="Contraseña" />
            <HBox spacing="10" alignment="CENTER">
                <Button text="Entrar" onAction="#onLogin" />
                <Button text="Registrar" onAction="#onShowRegister" />
            </HBox>
            <Label fx:id="messageLabel" textFill="red" />
        </VBox>
    </children>
</AnchorPane>


